# Copie para deploy/opy/.env na VPS (o .env não vai para o git). Gere segredos com: openssl rand -hex 32
OPY_HTTP_PORT=8101
OPY_SESSION_SECRET=
# TURN próprio (coturn neste compose). Use o subdomínio que apontar para a VPS.
OPY_PUBLIC_IP=
OPY_TURN_REALM=turn.exemplo.org
OPY_TURN_SECRET=
OPY_TURN_URLS=turn:turn.exemplo.org:3478?transport=udp,turn:turn.exemplo.org:3478?transport=tcp,turns:turn.exemplo.org:5349?transport=tcp
OPY_STUN_URLS=stun:turn.exemplo.org:3478
OPY_TURN_CERT_DIR=/etc/letsencrypt
